// ProStegi website database schema
// Provider: PostgreSQL (Neon) — προβλεπόμενο για Vercel deployment.
// Τοπικά: χρησιμοποιεί το ΊΔΙΟ Neon database (δωρεάν tier) ή local Postgres.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")  // Pooled connection (Neon: host με -pooler, χρησιμοποιείται από την εφαρμογή)
  directUrl = env("DIRECT_URL")    // Direct connection (χωρίς pooler — χρησιμοποιείται από prisma migrate/db push)
}

// Leads submitted through the contact form on the website
model ContactLead {
  id         String   @id @default(cuid())
  name       String
  phone      String
  email      String?
  systemType String?
  message    String?
  createdAt  DateTime @default(now())

  @@map("contact_leads")
}

// Παραγγελίες από το e-shop (τηλεφωνική επιβεβαίωση — χωρίς online πληρωμή)
model OrderRequest {
  id          String   @id @default(cuid())
  name        String
  phone       String
  email       String?
  city        String?
  contactTime String?
  items       String   // JSON: [{ slug, name, qty, price }]
  total       Float
  savings     Float    @default(0)
  notes       String?
  status      String   @default("new")
  createdAt   DateTime @default(now())

  @@map("order_requests")
}

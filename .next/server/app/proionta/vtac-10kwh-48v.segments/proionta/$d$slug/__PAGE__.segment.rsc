35:["$","$L33","panel-500w-mono",{"className":"h-full","children":["$","$L34",null,{"product":{"slug":"panel-500w-mono","name":"Φωτοβολταϊκό Πάνελ 500W Mono","brand":"Tier-1 Manufacturer","sku":"PV-PNL-500","category":"panels","image":"/products/solar-panels.png","alt":"Μονοκρυσταλλικό φωτοβολταϊκό πάνελ 500W half-cut","subtitle":"500W · Μονοκρυσταλλικό PERC","shortDesc":"Το πάνελ που επιλέγουμε για τις περισσότερες οικιακές εγκαταστάσεις: 500W με τεχνολογία half-cut PERC, αντοχή σε χαλάζι 25mm και εγγύηση απόδοσης 25 ετών.","badge":"offer","price":105,"oldPrice":122,"stock":"in","warranty":"15 έτη προϊόν · 25 έτη απόδοσης","highlights":["Τεχνολογία half-cut: λιγότερες απώλειες σε σκίαση","Πιστοποίηση αντοχής σε χαλάζι 25 mm (IEC 61215)","Πλαίσιο αλουμινίου 35mm για δυνατούς ανέμους"],"description":["Το 500W μονοκρυσταλλικό πάνελ με τεχνολογία half-cut PERC είναι η «χρυσή τομή» για οικιακές στέγες: με διαστάσεις μόλις 1,72 × 1,13 m χωράει άνετα σε σκεπή με καμινάδες και φράκτες, ενώ τα half-cut κελιά — το πάνελ είναι κομμένο στη μέση — μειώνουν τις απώλειες αντίστασης και βελτιώνουν τη συμπεριφορά σε μερική σκίαση από καμινάδα ή δέντρο.","Η επιφάνεια με αντιανακλαστική επίστρωση (ARC glass) δέχεται περισσότερο φως στις χαμηλές γωνίες του πρωινού και του απογεύματος, οπότε το σύστημα ξεκινά νωρίτερα και σταματά αργότερα — σε ετήσια βάση μετράμε 2–3% παραπάνω ενέργεια σε σχέση με πάνελ χωρίς επίστρωση.","Προμηθευόμαστε αποκλειστικά από κατασκευαστές Tier-1 του BloombergNEF με γραμμή παραγωγής πλήρως αυτοματοποιημένη, με αποτέλεσμα μικρή ανοχή ισχύος (0/+5W): το πάνελ που παραλαμβάνετε έχει τουλάχιστον την ονομαστική του ισχύ."],"specs":[{"label":"Ονομαστική ισχύς","value":"500 W (ανοχή 0/+5W)"},{"label":"Τεχνολογία κελιών","value":"Μονοκρυσταλλικά PERC, half-cut 144 κελιά"},{"label":"Απόδοση μονάδας","value":"21,1%"},{"label":"Τάση Vmp / Voc","value":"39,2 V / 46,8 V"},{"label":"Ρεύμα Imp / Isc","value":"12,76 A / 13,52 A"},{"label":"Συντελεστής θερμοκρασίας (Pmax)","value":"-0,35 %/°C"},{"label":"Διαστάσεις","value":"1.722 × 1.134 × 35 mm"},{"label":"Βάρος","value":"21,5 kg"},{"label":"Γυαλί","value":"3,2 mm ημι-σκληρυμένο με AR επίστρωση"},{"label":"Πιστοποιήσεις","value":"IEC 61215, IEC 61730, PID-free"},{"label":"Εγγύηση απόδοσης","value":"84,8% ισχύος στο 25ό έτος"},{"label":"Φορτία","value":"5.400 Pa (χιόνι) / 2.400 Pa (άεμος)"}],"related":["panel-700w-topcon","deye-sun-6k-sg04lp1","kit-stirigma-keramidi"]}}]}]

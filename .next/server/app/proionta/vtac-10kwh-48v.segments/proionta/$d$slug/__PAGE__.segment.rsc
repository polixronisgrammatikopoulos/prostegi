14:["$","section",null,{"className":"bg-[#f5f3ec] py-12 sm:py-16","aria-label":"Σχετικά προϊόντα","children":["$","div",null,{"className":"mx-auto max-w-7xl px-4 sm:px-6 lg:px-8","children":[["$","$L25",null,{"children":["$","div",null,{"className":"mb-8 text-center","children":[["$","p",null,{"className":"text-sm font-bold uppercase tracking-wider text-[#2c7a3e]","children":"Συνδυάστε σωστά"}],["$","h2",null,{"className":"mt-1 font-heading text-2xl font-extrabold text-[#0d4c74] sm:text-3xl","children":"Σχετικά Προϊόντα που Αναβαθμίζουν το Σύστημά σας"}],["$","p",null,{"className":"mx-auto mt-3 max-w-2xl text-[15px] leading-relaxed text-muted-foreground","children":["Προτάσεις 100% συμβατές με το ","V-TAC V11-48100 10.24 kWh"," — επιλεγμένες από τους μηχανικούς μας, όχι τυχαίες."]}]]}]}],["$","$L32",null,{"className":"grid gap-5 sm:grid-cols-2 lg:grid-cols-3","children":[["$","$L33","deye-sun-6k-sg04lp1",{"className":"h-full","children":["$","$L34",null,{"product":{"slug":"deye-sun-6k-sg04lp1","name":"Deye SUN-6K-SG04LP1","brand":"Deye","sku":"INV-DEY-6K","category":"inverters","image":"/products/deye-inverter.png","alt":"Υβριδικός inverter Deye SUN-6K-SG04LP1 6kW 48V","subtitle":"Υβριδικός Inverter 6 kW · 48V","shortDesc":"Ο δημοφιλέστερος μονοφασικός υβριδικός inverter για κατοικίες: 6 kW ισχύος, δύο MPPT και πλήρης αυτόνομη λειτουργία με μπαταρία 48V.","badge":"offer","price":1190,"oldPrice":1390,"stock":"in","warranty":"5 έτη εγγύηση αντιπροσωπείας","highlights":["Λειτουργία backup χωρίς διακοπή (off-grid + on-grid)","Δωρεάν παρακολούθηση από κινητό μέσω Wi-Fi","Παράλληλη σύνδεση έως 16 μονάδων","2 ανεξάρτητοι MPPT για διαφορετικές πλευρές στέγης"],"description":["Ο Deye SUN-6K-SG04LP1 είναι ο inverter που προτείνουμε στις περισσότερες κατοικίες μέχρι 130 τ.μ. με ετήσια κατανάλωση έως 9.000 kWh. Με 6 kW συνεχόμενης ισχύος εξόδου και δύο ανεξάρτητους ανιχνευτές μέγιστης ισχύος (MPPT), αξιοποιεί άψογα ακόμα και στέγες με δύο διαφορετικούς προσανατολισμούς — π.χ. νότια και δυτική πλευρά.","Η υβριδική αρχιτεκτονική του σημαίνει ένα μόνο μηχάνημα για όλα: τροφοδοτεί το σπίτι από τα πάνελ, φορτίζει μπαταρία 48V για το βράδυ, πωλεί το πλεόνασμα στο δίκτυο (net billing) και, σε διακοπή ρεύματος, αναλαμβάνει αυτόματα τα κρίσιμα φορτία σε λιγότερο από 10 χιλιοστά του δευτερολέπτου — τόσο γρήγορα που ούτε ο υπολογιστής ούτε το ψυγείο σας το καταλαβαίνουν.","Μέσω της δωρεάν εφαρμογής στο κινητό (iOS/Android) βλέπετε σε πραγματικό χρόνο την παραγωγή, την κατανάλωση και τη φόρτιση της μπαταρίας, ενώ ο ενσωματωμένος Wi-Fi data logger στέλνει αυτόματα τα δεδομένα — δεν χρειάζεται επιπλέον εξοπλισμός."],"specs":[{"label":"Ονομαστική ισχύς εξόδου AC","value":"6.000 W (μονοφασικός 230V)"},{"label":"Μέγιστη ισχύς DC εισόδου","value":"7.800 W"},{"label":"Αριθμός MPPT","value":"2 (ανεξάρτητοι, 1 string ανά MPPT)"},{"label":"Εύρος τάσης MPPT","value":"125–425 V"},{"label":"Τύπος μπαταρίας","value":"LiFePO4 / Lead-Acid 48V"},{"label":"Μέγιστη απόδοση μετατροπής","value":"97,6%"},{"label":"Ευρωπαϊκή απόδοση (EU)","value":"97,0%"},{"label":"Μετάβαση σε backup","value":"< 10 ms (αδιάλειπτη)"},{"label":"Επικοινωνία","value":"Wi-Fi (ενσωματωμένο), RS485/CAN"},{"label":"Πιστοποιήσεις","value":"CE, EN 50549, VDE 4105, G99"},{"label":"Διαστάσεις (Π×Β×Υ)","value":"434 × 565 × 185 mm"},{"label":"Βάρος","value":"21 kg"}],"related":["vtac-10kwh-48v","panel-500w-mono","deye-sun-8k-sg04lp1"]}}]}],["$","$L33","deye-se-g5.1-pro",{"className":"h-full","children":["$","$L34",null,{"product":{"slug":"deye-se-g5.1-pro","name":"Deye SE-G5.1 Pro 5.12 kWh","brand":"Deye","sku":"BAT-DEY-5K","category":"batteries","image":"/products/vtac-battery.png","alt":"Μπαταρία λιθίου Deye SE-G5.1 Pro 5.12kWh στοιβαζόμενη","subtitle":"Μπαταρία Λιθίου 5.12 kWh · 48V LFP","shortDesc":"Κομπακτική στοιβαζόμενη μπαταρία 5,12 kWh — η ιδανική λύση για να ξεκινήσετε με αποθήκευση και να επεκταθείτε αργότερα, μονάδα προς μονάδα.","price":1250,"stock":"in","warranty":"10 έτη εγγύηση κατασκευαστή","highlights":["Στοιβαζόμενη αρχιτεκτονική — επέκταση ανά 5 kWh","Αυτόματη αναγνώριση διεύθυνσης κατά τη σύνδεση","Τοποθέτηση χωρίς εργαλεία"],"description":["Η σειρά SE-G5.1 Pro της Deye σχεδιάστηκε για όσους θέλουν να ξεκινήσουν με λογικό κόστος αποθήκευσης και να μεγαλώσουν αργότερα. Κάθε μονάδα αποθηκεύει 5,12 kWh και μπορείτε να συνδέσετε έως 32 μονάδες στο ίδιο σύστημα — δηλαδή έως 163 kWh, περισσότερα από όσα χρειάζεται οποιοδήποτε σπίτι.","Η εγκατάσταση γίνεται στο δάπεδο: οι μονάδες τοποθετούνται σε βάση με τροχούς και συνδέονται μεταξύ τους με ένα μόνο busbar, χωρίς καλώδια και ρυθμίσεις — η διεύθυνση κάθε μονάδας αναγνωρίζεται αυτόματα. Δεν υπάρχει περίπτωση λάθους σύνδεσης, κάτι που μας έχει βγάλει ώρες εργασίας σε πολλές εγκαταστάσεις.","Το LFP στοιχείο προσφέρει 6.000+ κύκλους, ενώ το ενσωματωμένο BMS επικοινωνεί CAN με τους inverters Deye για ακριβή έλεγχο φόρτισης και μέγιστη διάρκεια ζωής."],"specs":[{"label":"Χωρητικότητα","value":"5,12 kWh (100 Ah @ 51,2V)"},{"label":"Χημεία","value":"LiFePO4 (LFP)"},{"label":"Βάθος εκφόρτισης (DOD)","value":"90%"},{"label":"Κύκλοι ζωής","value":"≥ 6.000 @ 80% DOD"},{"label":"Συνεχές ρεύμα εκφόρτισης","value":"100 A"},{"label":"Μέγιστες μονάδες σε παράλληλα","value":"32 (163 kWh σύστημα)"},{"label":"BMS","value":"Ενσωματωμένο, CAN/RS485"},{"label":"Τοποθέτηση","value":"Δάπεδο (στοιβάζομενη με βάση)"},{"label":"Προστασία","value":"IP21"},{"label":"Διαστάσεις (Π×Β×Υ)","value":"600 × 420 × 156 mm"},{"label":"Βάρος","value":"42 kg"}],"related":["deye-sun-8k-sg04lp1","vtac-10kwh-48v","deye-hv-rack-16kwh"]}}]}],"$L35"]}]]}]}]

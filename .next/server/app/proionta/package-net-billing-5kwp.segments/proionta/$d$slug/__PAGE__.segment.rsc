14:["$","section",null,{"className":"bg-[#f5f3ec] py-12 sm:py-16","aria-label":"Σχετικά προϊόντα","children":["$","div",null,{"className":"mx-auto max-w-7xl px-4 sm:px-6 lg:px-8","children":[["$","$L26",null,{"children":["$","div",null,{"className":"mb-8 text-center","children":[["$","p",null,{"className":"text-sm font-bold uppercase tracking-wider text-[#2c7a3e]","children":"Συνδυάστε σωστά"}],["$","h2",null,{"className":"mt-1 font-heading text-2xl font-extrabold text-[#0d4c74] sm:text-3xl","children":"Σχετικά Προϊόντα που Αναβαθμίζουν το Σύστημά σας"}],["$","p",null,{"className":"mx-auto mt-3 max-w-2xl text-[15px] leading-relaxed text-muted-foreground","children":["Προτάσεις 100% συμβατές με το ","Πακέτο Net-Billing 5 kWp + 5 kWh"," — επιλεγμένες από τους μηχανικούς μας, όχι τυχαίες."]}]]}]}],["$","$L31",null,{"className":"grid gap-5 sm:grid-cols-2 lg:grid-cols-3","children":[["$","$L32","package-hybrid-10kwp",{"className":"h-full","children":["$","$L33",null,{"product":{"slug":"package-hybrid-10kwp","name":"Πακέτο Υβριδικό Αυτονομίας 10 kWp + 20 kWh","brand":"ProΣτέγη — Πακέτα","sku":"PKG-HYB-10","category":"packages","image":"/products/solar-panels.png","alt":"Ολοκληρωμένο υβριδικό πακέτο φωτοβολταϊκού συστήματος 10kWp με 20kWh αποθήκευση","subtitle":"20 πάνελ · 10 kWp + 2× μπαταρία 10 kWh","shortDesc":"Σχεδόν πλήρης ενεργειακή ανεξαρτησία: 20 πάνελ, inverter 8 kW και 20 kWh αποθήκευση — για σπίτια με αντλία θερμότητας ή σε απομακρυσμένες περιοχές με ασταθές δίκτυο.","badge":"offer","price":14900,"oldPrice":15900,"stock":"in","warranty":"10 έτη εγγύηση εξοπλισμού & εγκατάστασης","highlights":["Καλύπτει έως 95% της ετήσιας κατανάλωσης","Αναμενόμενη ετήσια παραγωγή: ~15.000 kWh","Αδιάλειπτο backup για όλο το σπίτι (< 10 ms)"],"includes":["20 × φωτοβολταϊκά πάνελ 500W μονοκρυσταλλικά","1 × υβριδικός inverter Deye SUN-8K 48V (16A MPPT)","2 × μπαταρίες λιθίου 10,24 kWh V-TAC (20,5 kWh σύνολο)","Στηρίγματα κεραμοσκεπής ή αεροσκεπής","Πλήρης καλωδίωση, πίνακας προστασιών, κουτί DC/AC","Μελέτη, άδειες, σύνδεση ΔΕΔΔΗΕ & παράδοση σε λειτουργία","Ρύθμιση backup κυκλώματος για διακοπές ρεύματος"],"description":["Το πακέτο αυτό έχει ως στόχο την πλήρη ενεργειακή ελευθερία: είτε μένετε σε περιοχή με συχνές διακοπές, είτε έχετε αντλία θερμότητας και ηλεκτρικό αυτοκίνητο που «τρώνε» πολλή ενέργεια, είτε απλά θέλετε να μη βλέπετε ποτέ ξανά λογαριασμό ρεύματος.","Με 10 kWp πάνελ και 20 kWh αποθήκευσης, το σύστημα καλύπτει το χειμώνα το 60–70% της κατανάλωσης και το καλοκαίρι σχεδόν το 100% — με ετήσιο μέσο όρο 90–95%. Το πλεόνασμα του καλοκαιριού πωλείται στο δίκτυο με net billing και πιστώνεται για τους χειμερινούς μήνες.","Η λειτουργία backup της Deye αναλαμβάνει ολόκληρο το σπίτι σε διακοπή ρεύματος με μετάβαση κάτω των 10 ms — δεν χρειάζεται να επιλέξετε «κρίσιμα κυκλώματα»: ψυγείο, αντλία, φωτισμοί και πρίζες συνεχίζουν κανονικά."],"specs":[{"label":"Συνολική ισχύς πάνελ","value":"10,0 kWp (20 × 500W)"},{"label":"Αποθηκευτική χωρητικότητα","value":"20,48 kWh LiFePO4 (2 × 10,24)"},{"label":"Inverter","value":"Υβριδικός μονοφασικός 8 kW, 2 MPPT 16A"},{"label":"Απαιτούμενη επιφάνεια στέγης","value":"~36–40 τ.μ."},{"label":"Αναμενόμενη παραγωγή (Θεσ/νίκη)","value":"14.500–15.500 kWh/έτος"},{"label":"Αυτάρκεια","value":"90–95% ετησίως"},{"label":"Backup","value":"Ολόκληρη κατοικία, < 10 ms μετάβαση"},{"label":"Χρόνος υλοποίησης","value":"30–45 ημέρες από τη σύμβαση"}],"related":["package-net-billing-5kwp","vtac-10kwh-48v","panel-700w-topcon"]}}]}],["$","$L32","panel-500w-mono",{"className":"h-full","children":["$","$L33",null,{"product":{"slug":"panel-500w-mono","name":"Φωτοβολταϊκό Πάνελ 500W Mono","brand":"Tier-1 Manufacturer","sku":"PV-PNL-500","category":"panels","image":"/products/solar-panels.png","alt":"Μονοκρυσταλλικό φωτοβολταϊκό πάνελ 500W half-cut","subtitle":"500W · Μονοκρυσταλλικό PERC","shortDesc":"Το πάνελ που επιλέγουμε για τις περισσότερες οικιακές εγκαταστάσεις: 500W με τεχνολογία half-cut PERC, αντοχή σε χαλάζι 25mm και εγγύηση απόδοσης 25 ετών.","badge":"offer","price":105,"oldPrice":122,"stock":"in","warranty":"15 έτη προϊόν · 25 έτη απόδοσης","highlights":["Τεχνολογία half-cut: λιγότερες απώλειες σε σκίαση","Πιστοποίηση αντοχής σε χαλάζι 25 mm (IEC 61215)","Πλαίσιο αλουμινίου 35mm για δυνατούς ανέμους"],"description":["Το 500W μονοκρυσταλλικό πάνελ με τεχνολογία half-cut PERC είναι η «χρυσή τομή» για οικιακές στέγες: με διαστάσεις μόλις 1,72 × 1,13 m χωράει άνετα σε σκεπή με καμινάδες και φράκτες, ενώ τα half-cut κελιά — το πάνελ είναι κομμένο στη μέση — μειώνουν τις απώλειες αντίστασης και βελτιώνουν τη συμπεριφορά σε μερική σκίαση από καμινάδα ή δέντρο.","Η επιφάνεια με αντιανακλαστική επίστρωση (ARC glass) δέχεται περισσότερο φως στις χαμηλές γωνίες του πρωινού και του απογεύματος, οπότε το σύστημα ξεκινά νωρίτερα και σταματά αργότερα — σε ετήσια βάση μετράμε 2–3% παραπάνω ενέργεια σε σχέση με πάνελ χωρίς επίστρωση.","Προμηθευόμαστε αποκλειστικά από κατασκευαστές Tier-1 του BloombergNEF με γραμμή παραγωγής πλήρως αυτοματοποιημένη, με αποτέλεσμα μικρή ανοχή ισχύος (0/+5W): το πάνελ που παραλαμβάνετε έχει τουλάχιστον την ονομαστική του ισχύ."],"specs":[{"label":"Ονομαστική ισχύς","value":"500 W (ανοχή 0/+5W)"},{"label":"Τεχνολογία κελιών","value":"Μονοκρυσταλλικά PERC, half-cut 144 κελιά"},{"label":"Απόδοση μονάδας","value":"21,1%"},{"label":"Τάση Vmp / Voc","value":"39,2 V / 46,8 V"},{"label":"Ρεύμα Imp / Isc","value":"12,76 A / 13,52 A"},{"label":"Συντελεστής θερμοκρασίας (Pmax)","value":"-0,35 %/°C"},{"label":"Διαστάσεις","value":"1.722 × 1.134 × 35 mm"},{"label":"Βάρος","value":"21,5 kg"},{"label":"Γυαλί","value":"3,2 mm ημι-σκληρυμένο με AR επίστρωση"},{"label":"Πιστοποιήσεις","value":"IEC 61215, IEC 61730, PID-free"},{"label":"Εγγύηση απόδοσης","value":"84,8% ισχύος στο 25ό έτος"},{"label":"Φορτία","value":"5.400 Pa (χιόνι) / 2.400 Pa (άεμος)"}],"related":["panel-700w-topcon","deye-sun-6k-sg04lp1","kit-stirigma-keramidi"]}}]}],"$L34"]}]]}]}]

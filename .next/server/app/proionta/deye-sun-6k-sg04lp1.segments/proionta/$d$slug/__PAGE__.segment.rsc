14:["$","section",null,{"className":"bg-[#f5f3ec] py-12 sm:py-16","aria-label":"Σχετικά προϊόντα","children":["$","div",null,{"className":"mx-auto max-w-7xl px-4 sm:px-6 lg:px-8","children":[["$","$L23",null,{"children":["$","div",null,{"className":"mb-8 text-center","children":[["$","p",null,{"className":"text-sm font-bold uppercase tracking-wider text-[#2c7a3e]","children":"Συνδυάστε σωστά"}],["$","h2",null,{"className":"mt-1 font-heading text-2xl font-extrabold text-[#0d4c74] sm:text-3xl","children":"Σχετικά Προϊόντα που Αναβαθμίζουν το Σύστημά σας"}],["$","p",null,{"className":"mx-auto mt-3 max-w-2xl text-[15px] leading-relaxed text-muted-foreground","children":["Προτάσεις 100% συμβατές με το ","Deye SUN-6K-SG04LP1"," — επιλεγμένες από τους μηχανικούς μας, όχι τυχαίες."]}]]}]}],["$","$L31",null,{"className":"grid gap-5 sm:grid-cols-2 lg:grid-cols-3","children":[["$","$L32","vtac-10kwh-48v",{"className":"h-full","children":["$","$L33",null,{"product":{"slug":"vtac-10kwh-48v","name":"V-TAC V11-48100 10.24 kWh","brand":"V-TAC","sku":"BAT-VTAC-10K","category":"batteries","image":"/products/vtac-battery.png","alt":"Μπαταρία λιθίου V-TAC 10.24kWh 48V LiFePO4 κρεμαστή","subtitle":"Μπαταρία Λιθίου 10.24 kWh · 48V LFP","shortDesc":"Η μπαταρία που συνδυάζουμε στις περισσότερες εγκαταστάσεις: 10.24 kWh χρήσιμης ενέργειας LiFePO4, κρεμαστό σχέδιο που δεν καταλαμβάνει χώρο και 6.000+ κύκλοι ζωής.","badge":"offer","price":1850,"oldPrice":2390,"stock":"in","warranty":"10 έτη εγγύηση κατασκευαστή","highlights":["10,24 kWh χρήσιμη ενέργεια σε ενιαίο κουτί","6.000+ κύκλοι φόρτισης/εκφόρτισης (DOD 90%)","Κρεμαστό σχέδιο — καταλαμβάνει μόλις 20 cm τοίχου"],"description":["Η V-TAC V11-48100 είναι η μπαταρία που τοποθετούμε στις περισσότερες κατοικίες, και όχι τυχαία: με 10,24 kWh πραγματικά διαθέσιμης ενέργειας καλύπτει τη νυχτερινή κατανάλωση ενός μέσου νοικοκυριού, ενώ το LiFePO4 χημικό στοιχείο (LFP) είναι η πιο ασφαλής και μακροβιώτερη τεχνολογία λιθίου που υπάρχει σήμερα — χωρίς κοβάλτιο, χωρίς θερμική διαφυγή σε κανονικές συνθήκες.","Το κρεμαστό της σχέδιο είναι το δικό της πλεονέκτημα: αναρτάται σε τοίχο γκαράζ ή αποθήκης καταλαμβάνοντας μόλις 20 cm βάθος, με ενσωματωμένο BMS που προστατεύει από υπερφόρτιση, βαθιά εκφόρτιση, υπερθέρμανση και βραχυκύκλωμα. Η οθόνη LED δείχνει με μια ματιά τη στάθμη φόρτισης.","Επικοινωνεί CAN/RS485 με όλους τους inverters Deye του καταλόγου μας για ακριβή διαχείριση φόρτισης, ενώ η εγγύηση 10 ετών της επίσημης αντιπροσωπείας καλύπτει το 70% της αρχικής χωρητικότητας στο τέλος της περιόδου."],"specs":[{"label":"Χωρητικότητα","value":"10,24 kWh (200 Ah @ 51,2V)"},{"label":"Χημεία","value":"LiFePO4 (LFP) — χωρίς κοβάλτιο"},{"label":"Βάθος εκφόρτισης (DOD)","value":"90%"},{"label":"Κύκλοι ζωής","value":"≥ 6.000 @ 80% DOD, 25°C"},{"label":"Συνεχές ρεύμα εκφόρτισης","value":"100 A (5,12 kW @ 48V)"},{"label":"Τάση λειτουργίας","value":"44,8–56,8 V DC"},{"label":"BMS","value":"Ενσωματωμένο, CAN/RS485 για Deye"},{"label":"Θερμοκρασία λειτουργίας","value":"Φόρτιση 0°C έως +50°C"},{"label":"Προστασία","value":"IP21 — εσωτερική εγκατάσταση"},{"label":"Διαστάσεις (Π×Β×Υ)","value":"680 × 430 × 175 mm"},{"label":"Βάρος","value":"85 kg"}],"related":["deye-sun-6k-sg04lp1","deye-se-g5.1-pro","panel-500w-mono"]}}]}],["$","$L32","panel-500w-mono",{"className":"h-full","children":["$","$L33",null,{"product":{"slug":"panel-500w-mono","name":"Φωτοβολταϊκό Πάνελ 500W Mono","brand":"Tier-1 Manufacturer","sku":"PV-PNL-500","category":"panels","image":"/products/solar-panels.png","alt":"Μονοκρυσταλλικό φωτοβολταϊκό πάνελ 500W half-cut","subtitle":"500W · Μονοκρυσταλλικό PERC","shortDesc":"Το πάνελ που επιλέγουμε για τις περισσότερες οικιακές εγκαταστάσεις: 500W με τεχνολογία half-cut PERC, αντοχή σε χαλάζι 25mm και εγγύηση απόδοσης 25 ετών.","badge":"offer","price":105,"oldPrice":122,"stock":"in","warranty":"15 έτη προϊόν · 25 έτη απόδοσης","highlights":["Τεχνολογία half-cut: λιγότερες απώλειες σε σκίαση","Πιστοποίηση αντοχής σε χαλάζι 25 mm (IEC 61215)","Πλαίσιο αλουμινίου 35mm για δυνατούς ανέμους"],"description":["Το 500W μονοκρυσταλλικό πάνελ με τεχνολογία half-cut PERC είναι η «χρυσή τομή» για οικιακές στέγες: με διαστάσεις μόλις 1,72 × 1,13 m χωράει άνετα σε σκεπή με καμινάδες και φράκτες, ενώ τα half-cut κελιά — το πάνελ είναι κομμένο στη μέση — μειώνουν τις απώλειες αντίστασης και βελτιώνουν τη συμπεριφορά σε μερική σκίαση από καμινάδα ή δέντρο.","Η επιφάνεια με αντιανακλαστική επίστρωση (ARC glass) δέχεται περισσότερο φως στις χαμηλές γωνίες του πρωινού και του απογεύματος, οπότε το σύστημα ξεκινά νωρίτερα και σταματά αργότερα — σε ετήσια βάση μετράμε 2–3% παραπάνω ενέργεια σε σχέση με πάνελ χωρίς επίστρωση.","Προμηθευόμαστε αποκλειστικά από κατασκευαστές Tier-1 του BloombergNEF με γραμμή παραγωγής πλήρως αυτοματοποιημένη, με αποτέλεσμα μικρή ανοχή ισχύος (0/+5W): το πάνελ που παραλαμβάνετε έχει τουλάχιστον την ονομαστική του ισχύ."],"specs":[{"label":"Ονομαστική ισχύς","value":"500 W (ανοχή 0/+5W)"},{"label":"Τεχνολογία κελιών","value":"Μονοκρυσταλλικά PERC, half-cut 144 κελιά"},{"label":"Απόδοση μονάδας","value":"21,1%"},{"label":"Τάση Vmp / Voc","value":"39,2 V / 46,8 V"},{"label":"Ρεύμα Imp / Isc","value":"12,76 A / 13,52 A"},{"label":"Συντελεστής θερμοκρασίας (Pmax)","value":"-0,35 %/°C"},{"label":"Διαστάσεις","value":"1.722 × 1.134 × 35 mm"},{"label":"Βάρος","value":"21,5 kg"},{"label":"Γυαλί","value":"3,2 mm ημι-σκληρυμένο με AR επίστρωση"},{"label":"Πιστοποιήσεις","value":"IEC 61215, IEC 61730, PID-free"},{"label":"Εγγύηση απόδοσης","value":"84,8% ισχύος στο 25ό έτος"},{"label":"Φορτία","value":"5.400 Pa (χιόνι) / 2.400 Pa (άεμος)"}],"related":["panel-700w-topcon","deye-sun-6k-sg04lp1","kit-stirigma-keramidi"]}}]}],"$L34"]}]]}]}]

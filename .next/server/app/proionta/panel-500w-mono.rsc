2a:["$","section",null,{"className":"bg-[#f5f3ec] py-12 sm:py-16","aria-label":"Σχετικά προϊόντα","children":["$","div",null,{"className":"mx-auto max-w-7xl px-4 sm:px-6 lg:px-8","children":[["$","$L25",null,{"children":["$","div",null,{"className":"mb-8 text-center","children":[["$","p",null,{"className":"text-sm font-bold uppercase tracking-wider text-[#2c7a3e]","children":"Συνδυάστε σωστά"}],["$","h2",null,{"className":"mt-1 font-heading text-2xl font-extrabold text-[#0d4c74] sm:text-3xl","children":"Σχετικά Προϊόντα που Αναβαθμίζουν το Σύστημά σας"}],["$","p",null,{"className":"mx-auto mt-3 max-w-2xl text-[15px] leading-relaxed text-muted-foreground","children":["Προτάσεις 100% συμβατές με το ","Φωτοβολταϊκό Πάνελ 500W Mono"," — επιλεγμένες από τους μηχανικούς μας, όχι τυχαίες."]}]]}]}],["$","$L39",null,{"className":"grid gap-5 sm:grid-cols-2 lg:grid-cols-3","children":[["$","$L3a","panel-700w-topcon",{"className":"h-full","children":["$","$L3b",null,{"product":{"slug":"panel-700w-topcon","name":"Φωτοβολταϊκό Πάνελ 700W N-Type TOPCon","brand":"Tier-1 Manufacturer","sku":"PV-PNL-700","category":"panels","image":"/products/solar-panels.png","alt":"Φωτοβολταϊκό πάνελ 700W N-Type TOPCon νέας γενιάς","subtitle":"700W · N-Type TOPCon","shortDesc":"Η νέα γενιά πάνελ N-Type TOPCon: 700W σε ένα πλαίσιο, απόδοση 22,3% και εγγύηση απόδοσης 30 ετών — περισσότερη ενέργεια ανά τ.μ. στέγης.","badge":"new","price":152,"stock":"in","warranty":"25 έτη προϊόν · 30 έτη απόδοσης","highlights":["Απόδοση 22,3% — η κορυφή της αγοράς","Εγγύηση απόδοσης 30 ετών (87,4% στο τέλος)","Χαμηλότερος συντελεστής θερμοκρασίας (-0,30%/°C)"],"description":["Τα πάνελ N-Type TOPCon είναι η σημερινή κορυφή της φωτοβολταϊκής τεχνολογίας. Ένα πάνελ 700W παράγει όσο δύο πάνελ 350W προηγούμενης γενιάς, με λιγότερα στηρίγματα, λιγότερη εργασία τοποθέτησης και λιγότερους συνδέσμους που μπορούν να φθαρούν με τα χρόνια. Για στέγες με περιορισμένο χώρο, η διαφορά είναι καθοριστική: στον ίδιο χώρο, παίρνετε 40% παραπάνω ενέργεια.","Το N-Type κρυσταλλικό στοιχείο έχει θεμελιώδες πλεονέκτημα έναντι του P-Type: αποφεύγει τον απαξιωτικό μηχανισμό LID (Light Induced Degradation), οπότε το πάνελ δεν «χάνει» τα πρώτα 2–3% της ισχύος του τους πρώτους μήνες. Επιπλέον, ο χαμηλότερος συντελεστής θερμοκρασίας (-0,30%/°C) σημαίνει μικρότερη πτώση απόδοσης στα καύσωνα — μετρήσιμη διαφορά σε ετήσια βάση στην Ελλάδα.","Πρόκειται για το πάνελ που χρησιμοποιούμε στις νέες εγκαταστάσεις μας όταν ο χώρος ή οι ενεργειακοί στόχοι το απαιτούν, καθώς και σε όλα τα ολοκληρωμένα πακέτα του καταλόγου."],"specs":[{"label":"Ονομαστική ισχύς","value":"700 W (ανοχή 0/+5W)"},{"label":"Τεχνολογία κελιών","value":"N-Type TOPCon, half-cut 132 κελιά"},{"label":"Απόδοση μονάδας","value":"22,3%"},{"label":"Τάση Vmp / Voc","value":"38,4 V / 45,5 V"},{"label":"Ρεύμα Imp / Isc","value":"18,23 A / 19,30 A"},{"label":"Συντελεστής θερμοκρασίας (Pmax)","value":"-0,30 %/°C"},{"label":"Απαξίωση LID/LeTID","value":"Ουσιαστικά μηδενική (N-Type)"},{"label":"Διαστάσεις","value":"2.382 × 1.134 × 30 mm"},{"label":"Βάρος","value":"28,5 kg"},{"label":"Πιστοποιήσεις","value":"IEC 61215, IEC 61730, PID-free"},{"label":"Εγγύηση απόδοσης","value":"87,4% ισχύος στο 30ό έτος"},{"label":"Φορτία","value":"5.400 Pa (χιόνι) / 2.400 Pa (άεμος)"}],"related":["panel-500w-mono","deye-sun-8k-sg04lp1","kit-stirigma-keramidi"]}}]}],["$","$L3a","deye-sun-6k-sg04lp1",{"className":"h-full","children":["$","$L3b",null,{"product":{"slug":"deye-sun-6k-sg04lp1","name":"Deye SUN-6K-SG04LP1","brand":"Deye","sku":"INV-DEY-6K","category":"inverters","image":"/products/deye-inverter.png","alt":"Υβριδικός inverter Deye SUN-6K-SG04LP1 6kW 48V","subtitle":"Υβριδικός Inverter 6 kW · 48V","shortDesc":"Ο δημοφιλέστερος μονοφασικός υβριδικός inverter για κατοικίες: 6 kW ισχύος, δύο MPPT και πλήρης αυτόνομη λειτουργία με μπαταρία 48V.","badge":"offer","price":1190,"oldPrice":1390,"stock":"in","warranty":"5 έτη εγγύηση αντιπροσωπείας","highlights":["Λειτουργία backup χωρίς διακοπή (off-grid + on-grid)","Δωρεάν παρακολούθηση από κινητό μέσω Wi-Fi","Παράλληλη σύνδεση έως 16 μονάδων","2 ανεξάρτητοι MPPT για διαφορετικές πλευρές στέγης"],"description":["Ο Deye SUN-6K-SG04LP1 είναι ο inverter που προτείνουμε στις περισσότερες κατοικίες μέχρι 130 τ.μ. με ετήσια κατανάλωση έως 9.000 kWh. Με 6 kW συνεχόμενης ισχύος εξόδου και δύο ανεξάρτητους ανιχνευτές μέγιστης ισχύος (MPPT), αξιοποιεί άψογα ακόμα και στέγες με δύο διαφορετικούς προσανατολισμούς — π.χ. νότια και δυτική πλευρά.","Η υβριδική αρχιτεκτονική του σημαίνει ένα μόνο μηχάνημα για όλα: τροφοδοτεί το σπίτι από τα πάνελ, φορτίζει μπαταρία 48V για το βράδυ, πωλεί το πλεόνασμα στο δίκτυο (net billing) και, σε διακοπή ρεύματος, αναλαμβάνει αυτόματα τα κρίσιμα φορτία σε λιγότερο από 10 χιλιοστά του δευτερολέπτου — τόσο γρήγορα που ούτε ο υπολογιστής ούτε το ψυγείο σας το καταλαβαίνουν.","Μέσω της δωρεάν εφαρμογής στο κινητό (iOS/Android) βλέπετε σε πραγματικό χρόνο την παραγωγή, την κατανάλωση και τη φόρτιση της μπαταρίας, ενώ ο ενσωματωμένος Wi-Fi data logger στέλνει αυτόματα τα δεδομένα — δεν χρειάζεται επιπλέον εξοπλισμός."],"specs":[{"label":"Ονομαστική ισχύς εξόδου AC","value":"6.000 W (μονοφασικός 230V)"},{"label":"Μέγιστη ισχύς DC εισόδου","value":"7.800 W"},{"label":"Αριθμός MPPT","value":"2 (ανεξάρτητοι, 1 string ανά MPPT)"},{"label":"Εύρος τάσης MPPT","value":"125–425 V"},{"label":"Τύπος μπαταρίας","value":"LiFePO4 / Lead-Acid 48V"},{"label":"Μέγιστη απόδοση μετατροπής","value":"97,6%"},{"label":"Ευρωπαϊκή απόδοση (EU)","value":"97,0%"},{"label":"Μετάβαση σε backup","value":"< 10 ms (αδιάλειπτη)"},{"label":"Επικοινωνία","value":"Wi-Fi (ενσωματωμένο), RS485/CAN"},{"label":"Πιστοποιήσεις","value":"CE, EN 50549, VDE 4105, G99"},{"label":"Διαστάσεις (Π×Β×Υ)","value":"434 × 565 × 185 mm"},{"label":"Βάρος","value":"21 kg"}],"related":["vtac-10kwh-48v","panel-500w-mono","deye-sun-8k-sg04lp1"]}}]}],"$L3c"]}]]}]}]

28:["$","section",null,{"className":"bg-[#f5f3ec] py-12 sm:py-16","aria-label":"Σχετικά προϊόντα","children":["$","div",null,{"className":"mx-auto max-w-7xl px-4 sm:px-6 lg:px-8","children":[["$","$L2a",null,{"children":["$","div",null,{"className":"mb-8 text-center","children":[["$","p",null,{"className":"text-sm font-bold uppercase tracking-wider text-[#2c7a3e]","children":"Συνδυάστε σωστά"}],["$","h2",null,{"className":"mt-1 font-heading text-2xl font-extrabold text-[#0d4c74] sm:text-3xl","children":"Σχετικά Προϊόντα που Αναβαθμίζουν το Σύστημά σας"}],["$","p",null,{"className":"mx-auto mt-3 max-w-2xl text-[15px] leading-relaxed text-muted-foreground","children":["Προτάσεις 100% συμβατές με το ","Πακέτο Υβριδικό Αυτονομίας 10 kWp + 20 kWh"," — επιλεγμένες από τους μηχανικούς μας, όχι τυχαίες."]}]]}]}],["$","$L36",null,{"className":"grid gap-5 sm:grid-cols-2 lg:grid-cols-3","children":[["$","$L37","package-net-billing-5kwp",{"className":"h-full","children":["$","$L38",null,{"product":{"slug":"package-net-billing-5kwp","name":"Πακέτο Net-Billing 5 kWp + 5 kWh","brand":"ProΣτέγη — Πακέτα","sku":"PKG-NET-5","category":"packages","image":"/products/solar-panels.png","alt":"Ολοκληρωμένο πακέτο φωτοβολταϊκού συστήματος net billing 5kWp με μπαταρία 5kWh","subtitle":"10 πάνελ · 5 kWp + μπαταρία 5 kWh","shortDesc":"Το ολοκληρωμένο πακέτο για το μέσο ελληνικό σπίτι: 10 πάνελ 500W, υβριδικός inverter 6 kW, μπαταρία 5 kWh και πλήρης εγκατάσταση με άδειες.","badge":"bestseller","price":6850,"oldPrice":7400,"stock":"in","warranty":"10 έτη εγγύηση εξοπλισμού & εγκατάστασης","highlights":["Έτοιμο προς εγκατάσταση — περιλαμβάνει άδειες & σύνδεση ΔΕΔΔΗΕ","Αναμενόμενη ετήσια παραγωγή: ~7.500 kWh","Καλύπτει κατανάλωση 100–140 τ.μ. κατοικίας"],"includes":["10 × φωτοβολταϊκά πάνελ 500W μονοκρυσταλλικά","1 × υβριδικός inverter Deye SUN-6K 48V","1 × μπαταρία λιθίου 5,12 kWh (Deye SE-G5.1 Pro)","Στηρίγματα κεραμοσκεπής από αλουμίνιο EN AW-6005A","Πλήρης καλωδίωση DC/AC, προστασίες AC & DC, γείωση","Μελέτη, άδειες (ΡΑΕ/ΔΕΔΔΗΕ), σύνδεση & παράδοση σε λειτουργία","Ρύθμιση εφαρμογής παρακολούθησης στο κινητό σας"],"description":["Αυτό το πακέτο σχεδιάσαμε για το μέσο ελληνικό σπίτι με ετήσια κατανάλωση 6.000–9.000 kWh. Δέκα πάνελ 500W σε νότια κλίση παράγουν στην περιοχή της Θεσσαλονίκης περίπου 7.500 kWh ετησίως — όση ενέργεια, δηλαδή, χρειάζεται μια οικογένεια με κλιματισμό και ηλεκτρικό boiler.","Η μπαταρία 5 kWh αποθηκεύει το πλεόνασμα του μεσημεριού για το βράδυ, οπότε το μεγαλύτερο μέρος της κατανάλωσής σας γίνεται από τον ήλιο και όχι από το δίκτυο. Ο υβριδικός inverter Deye αναλαμβάνει αυτόματα τη διαχείριση: τροφοδοτεί το σπίτι, φορτίζει την μπαταρία, πουλάει το υπόλοιπο στο δίκτυο με net billing.","Η τιμή περιλαμβάνει ό,τι χρειάζεται από τη μελέτη έως την παράδοση: άδειες, αίτηση στο ΔΕΔΔΗΕ, υλικά, εργασία και ρύθμιση της εφαρμογής. Μόλις η εγκατάσταση βγει «στον αέρα», σας εκπαιδεύουμε στην εφαρμογή και αφήνουμε γραπτές οδηγίες στον πίνακα."],"specs":[{"label":"Συνολική ισχύς πάνελ","value":"5,0 kWp (10 × 500W)"},{"label":"Αποθηκευτική χωρητικότητα","value":"5,12 kWh LiFePO4"},{"label":"Inverter","value":"Υβριδικός μονοφασικός 6 kW, 2 MPPT"},{"label":"Απαιτούμενη επιφάνεια στέγης","value":"~18–20 τ.μ. (νότια κλίση 25–40°)"},{"label":"Αναμενόμενη παραγωγή (Θεσ/νίκη)","value":"7.200–7.800 kWh/έτος"},{"label":"Επιπλέον κόστος","value":"Κανένα — τελική τιμή με ΦΠΑ"},{"label":"Χρόνος υλοποίησης","value":"30–45 ημέρες από τη σύμβαση"},{"label":"Εγκατάσταση","value":"Περιλαμβάνεται (πιστοποιημένο συνεργείο)"}],"related":["package-hybrid-10kwp","panel-500w-mono","deye-sun-6k-sg04lp1"]}}]}],["$","$L37","vtac-10kwh-48v",{"className":"h-full","children":["$","$L38",null,{"product":{"slug":"vtac-10kwh-48v","name":"V-TAC V11-48100 10.24 kWh","brand":"V-TAC","sku":"BAT-VTAC-10K","category":"batteries","image":"/products/vtac-battery.png","alt":"Μπαταρία λιθίου V-TAC 10.24kWh 48V LiFePO4 κρεμαστή","subtitle":"Μπαταρία Λιθίου 10.24 kWh · 48V LFP","shortDesc":"Η μπαταρία που συνδυάζουμε στις περισσότερες εγκαταστάσεις: 10.24 kWh χρήσιμης ενέργειας LiFePO4, κρεμαστό σχέδιο που δεν καταλαμβάνει χώρο και 6.000+ κύκλοι ζωής.","badge":"offer","price":1850,"oldPrice":2390,"stock":"in","warranty":"10 έτη εγγύηση κατασκευαστή","highlights":["10,24 kWh χρήσιμη ενέργεια σε ενιαίο κουτί","6.000+ κύκλοι φόρτισης/εκφόρτισης (DOD 90%)","Κρεμαστό σχέδιο — καταλαμβάνει μόλις 20 cm τοίχου"],"description":["Η V-TAC V11-48100 είναι η μπαταρία που τοποθετούμε στις περισσότερες κατοικίες, και όχι τυχαία: με 10,24 kWh πραγματικά διαθέσιμης ενέργειας καλύπτει τη νυχτερινή κατανάλωση ενός μέσου νοικοκυριού, ενώ το LiFePO4 χημικό στοιχείο (LFP) είναι η πιο ασφαλής και μακροβιώτερη τεχνολογία λιθίου που υπάρχει σήμερα — χωρίς κοβάλτιο, χωρίς θερμική διαφυγή σε κανονικές συνθήκες.","Το κρεμαστό της σχέδιο είναι το δικό της πλεονέκτημα: αναρτάται σε τοίχο γκαράζ ή αποθήκης καταλαμβάνοντας μόλις 20 cm βάθος, με ενσωματωμένο BMS που προστατεύει από υπερφόρτιση, βαθιά εκφόρτιση, υπερθέρμανση και βραχυκύκλωμα. Η οθόνη LED δείχνει με μια ματιά τη στάθμη φόρτισης.","Επικοινωνεί CAN/RS485 με όλους τους inverters Deye του καταλόγου μας για ακριβή διαχείριση φόρτισης, ενώ η εγγύηση 10 ετών της επίσημης αντιπροσωπείας καλύπτει το 70% της αρχικής χωρητικότητας στο τέλος της περιόδου."],"specs":[{"label":"Χωρητικότητα","value":"10,24 kWh (200 Ah @ 51,2V)"},{"label":"Χημεία","value":"LiFePO4 (LFP) — χωρίς κοβάλτιο"},{"label":"Βάθος εκφόρτισης (DOD)","value":"90%"},{"label":"Κύκλοι ζωής","value":"≥ 6.000 @ 80% DOD, 25°C"},{"label":"Συνεχές ρεύμα εκφόρτισης","value":"100 A (5,12 kW @ 48V)"},{"label":"Τάση λειτουργίας","value":"44,8–56,8 V DC"},{"label":"BMS","value":"Ενσωματωμένο, CAN/RS485 για Deye"},{"label":"Θερμοκρασία λειτουργίας","value":"Φόρτιση 0°C έως +50°C"},{"label":"Προστασία","value":"IP21 — εσωτερική εγκατάσταση"},{"label":"Διαστάσεις (Π×Β×Υ)","value":"680 × 430 × 175 mm"},{"label":"Βάρος","value":"85 kg"}],"related":["deye-sun-6k-sg04lp1","deye-se-g5.1-pro","panel-500w-mono"]}}]}],"$L39"]}]]}]}]

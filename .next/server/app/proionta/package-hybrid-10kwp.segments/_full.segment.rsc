ηση υποσέλιδου","children":[["$","h3",null,{"className":"font-heading text-base font-bold uppercase tracking-wider text-white/90","children":"Σελίδες"}],["$","ul",null,{"className":"mt-4 space-y-2.5","children":[["$","li","/",{"children":["$","$L24",null,{"href":"/","className":"text-[15px] text-white/70 transition-colors hover:text-white","children":"Αρχική"}]}],["$","li","/fotovoltaika",{"children":["$","$L24",null,{"href":"/fotovoltaika","className":"text-[15px] text-white/70 transition-colors hover:text-white","children":"Φωτοβολταϊκά Συστήματα"}]}],["$","li","/paketa",{"children":["$","$L24",null,{"href":"/paketa","className":"text-[15px] text-white/70 transition-colors hover:text-white","children":"Ολοκληρωμένα Πακέτα 5–20 kW"}]}],["$","li","/proionta",{"children":["$","$L24",null,{"href":"/proionta","className":"text-[15px] text-white/70 transition-colors hover:text-white","children":"E-shop Προϊόντων"}]}],["$","li","/ypiresies",{"children":["$","$L24",null,{"href":"/ypiresies","className":"text-[15px] text-white/70 transition-colors hover:text-white","children":"Υπηρεσίες & Πακέτα"}]}],["$","li","/ypologistis",{"children":["$","$L24",null,{"href":"/ypologistis","className":"text-[15px] text-white/70 transition-colors hover:text-white","children":"Υπολογιστής Εξοικονόμησης"}]}],["$","li","/etaireia",{"children":["$","$L24",null,{"href":"/etaireia","className":"text-[15px] text-white/70 transition-colors hover:text-white","children":"Η Εταιρεία μας"}]}],["$","li","/faq",{"children":["$","$L24",null,{"href":"/faq","className":"text-[15px] text-white/70 transition-colors hover:text-white","children":"Συχνές Ερωτήσεις"}]}],["$","li","/epikoinonia",{"children":["$","$L24",null,{"href":"/epikoinonia","className":"text-[15px] text-white/70 transition-colors hover:text-white","children":"Επικοινωνία"}]}]]}]]}],["$","div",null,{"children":[["$","h3",null,{"className":"font-heading text-base font-bold uppercase tracking-wider text-white/90","children":"Επικοινωνία"}],[
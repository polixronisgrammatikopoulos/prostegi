6:T805,{"@context":"https://schema.org","@type":"ElectricalContractor","@id":"https://www.prostegi.gr/#localbusiness","name":"ProΣτέγη","image":"https://www.prostegi.gr/logo.png","logo":"https://www.prostegi.gr/logo-square.png","url":"https://www.prostegi.gr","telephone":"+302310644512","email":"info@prostegi.gr","priceRange":"€€","description":"Εγκατάσταση αυτόνων, διασυνδεδεμένων (Net Billing) και υβριδικών φωτοβολταϊκών συστημάτων με μπαταρίες λιθίου Deye & V-TAC στη Θεσσαλονίκη και τη Βόρεια Ελλάδα.","address":{"@type":"PostalAddress","streetAddress":"Καραολή & Δημητρίου 242","addressLocality":"Εύοσμος","addressRegion":"Θεσσαλονίκη","postalCode":"56431","addressCountry":"GR"},"geo":{"@type":"GeoCoordinates","latitude":40.6725,"longitude":22.9305},"areaServed":[{"@type":"City","name":"Θεσσαλονίκη"},{"@type":"AdministrativeArea","name":"Κεντρική Μακεδονία"},{"@type":"AdministrativeArea","name":"Δυτική Μακεδονία"},{"@type":"AdministrativeArea","name":"Ανατολική Μακεδονία & Θράκη"}],"sameAs":[],"hasOfferCatalog":{"@type":"OfferCatalog","name":"Φωτοβολταϊκές Υπηρεσίες","itemListElement":[{"@type":"Offer","itemOffered":{"@type":"Service","name":"Αυτόνομα φωτοβολταϊκά συστήματα (Off-Grid)"}},{"@type":"Offer","itemOffered":{"@type":"Service","name":"Διασυνδεδεμένα φωτοβολταϊκά (Net Billing)"}},{"@type":"Offer","itemOffered":{"@type":"Service","name":"Υβριδικά φωτοβολταϊκά με μπαταρίες αποθήκευσης"}},{"@type":"Offer","itemOffered":{"@type":"Service","name":"Επαγγελματικές & αγροτικές φωτοβολταϊκές εγκαταστάσεις"}},{"@type":"Offer","itemOffered":{"@type":"Service","name":"Συντήρηση & υποστήριξη φωτοβολταϊκών"}}]}}b:X

ίκτυο, ο υβριδικός inverter Deye αλλάζει σε λειτουργία island μέσα σε χιλιοστά του δευτερολέπτου — το ψυγείο, τα φώτα, ο λέβητας και το ίντερνετ συνεχίζουν να λειτουργούν αδιάκοπα. Οι έξυπνες συσκευές Deye διαχειρίζονται αυτόματα τις ενεργειακές ροές μέσω εφαρμογής στο κινητό σας."}]],["$","ul",null,{"className":"mt-5 grid gap-2.5 sm:grid-cols-2","children":[["$","li","Αυτοκατανάλωση έως 85–90%",{"className":"flex items-start gap-2 text-sm font-medium text-foreground/85","children":[["$","svg",null,{"ref":"$undefined","xmlns":"http://www.w3.org/2000/svg","width":24,"height":24,"viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":2,"strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-check mt-0.5 h-4 w-4 shrink-0 text-[#2c7a3e]","aria-hidden":true,"children":[["$","path","1gmf2c",{"d":"M20 6 9 17l-5-5"}],"$undefined"]}],"Αυτοκατανάλωση έως 85–90%"]}],["$","li","Αυτόματο backup σε κάθε διακοπή ρεύματος",{"className":"flex items-start gap-2 text-sm font-medium text-foreground/85","children":[["$","svg",null,{"ref":"$undefined","xmlns":"http://www.w3.org/2000/svg","width":24,"height":24,"viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":2,"strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-check mt-0.5 h-4 w-4 shrink-0 text-[#2c7a3e]","aria-hidden":true,"children":[["$","path","1gmf2c",{"d":"M20 6 9 17l-5-5"}],"$undefined"]}],"Αυτόματο backup σε κάθε διακοπή ρεύματος"]}],["$","li","Έξυπνη διαχείριση ενέργειας από εφαρμογή κινητού",{"className":"flex items-start gap-2 text-sm font-medium text-foreground/85","children":[["$","svg",null,{"ref":"$undefined","xmlns":"http://www.w3.org/2000/svg","width":24,"height":24,"viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":2,"strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-check mt-0.5 h-4 w-4 shrink-0 text-[#2c7a3e]","aria-hidden":true,"children":[["$","path","1gmf2c",{"d":"M20 6 9 17l-5-5"}